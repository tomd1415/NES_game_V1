{
  "name": "native guard suite",
  "why": "Every guard added over 2026-08-06..12 was proved red BY HAND. Six manual steps with no feedback when one is skipped; I skipped one and got another wrong. These are the same breaks, performed by a tool that fails when a named assertion stays green.",
  "command": [
    "bash",
    "-c",
    "cd native && PYTHONPATH=src QT_QPA_PLATFORM=offscreen /root/.local/pipx/venvs/pytest/bin/python -m unittest -v tests.contract.test_phase0_starter_fixtures tests.unit.test_fixtures_are_tracked tests.contract.test_codegen_stays_snapshottable tests.unit.test_pyside_import_guards tests.contract.test_validator_parity tests.unit.test_icons tests.contract.test_baseline_manifest tests.contract.test_duplicated_helpers_agree tests.unit.test_friendly_build_error tests.unit.test_registries_are_complete"
  ],
  "breaks": [
    {
      "id": "baseline-scope-no-longer-matches",
      "file": "native/tests/contract/baseline.json",
      "find": "\"scope\": \"studio_plus_legacy_union\"",
      "replace": "\"scope\": \"studio_only\"",
      "expect": [
        "test_manifest_tracks_the_live_engine_baseline"
      ]
    },
    {
      "id": "baseline-command-emptied",
      "file": "native/tests/contract/baseline.json",
      "find": "\"command\": \"node scripts/snapshot-engine.mjs --check\"",
      "replace": "\"command\": \"\"",
      "expect": [
        "test_automated_results_are_attributed_to_a_command_and_a_date"
      ]
    },
    {
      "id": "baseline-caveat-weakened",
      "file": "native/tests/contract/baseline.json",
      "find": "It does not re-run any of the evidence below, and it does not mean the product is correct.",
      "replace": "It re-runs nothing and guarantees nothing.",
      "expect": [
        "test_the_record_says_what_a_pass_does_and_does_not_mean"
      ]
    },
    {
      "id": "baseline-golden-hashes-disagree",
      "file": "native/tests/contract/baseline.json",
      "find": "\"stock\": \"1730448eca6d4857d3468407b33e41de7806bf99\"",
      "replace": "\"stock\": \"0730448eca6d4857d3468407b33e41de7806bf99\"",
      "expect": [
        "test_golden_hashes_are_explicit"
      ]
    },
    {
      "id": "baseline-v63-attestation-relabelled-current",
      "file": "native/tests/contract/baseline.json",
      "find": "\"applies_to_engine_version\": 63",
      "replace": "\"applies_to_engine_version\": 76",
      "expect": [
        "test_the_v63_attestation_is_not_passed_off_as_current"
      ]
    },
    {
      "id": "starter-rom-hash-drift",
      "file": "native/tests/fixtures/phase0/starters/manifest.json",
      "find": "4d11fa59045c4fc6dd9f6edf0d65bfbb4f868e1a401138067e317d3cba5e829b",
      "replace": "0d11fa59045c4fc6dd9f6edf0d65bfbb4f868e1a401138067e317d3cba5e829b",
      "expect": [
        "test_artifact_hashes_and_input_immutability_match"
      ]
    },
    {
      "id": "codegen-delegation-inlined",
      "file": "tools/playground_server.py",
      "find": "    return scene_core.build_scene_inc(",
      "replace": "    _extra_statement = 1\n    return scene_core.build_scene_inc(",
      "expect": [
        "test_every_rom_emitting_entry_point_delegates_to_the_core_package"
      ]
    },
    {
      "id": "pyside-import-guard-removed",
      "file": "native/tests/unit/test_portability.py",
      "find": "pytest.importorskip(\"PySide6\")  # noqa: E402",
      "replace": "# guard removed by mutation",
      "expect": [
        "test_no_test_module_needs_pyside6_to_be_imported"
      ]
    },
    {
      "id": "snapshot-include-list-removed",
      "file": "scripts/snapshot-engine.mjs",
      "find": "  'tools/nes_studio_core',",
      "replace": "  // removed for now: tools/nes_studio_core was slowing the walk",
      "expect": [
        "test_the_snapshot_actually_includes_the_package_it_delegates_to"
      ]
    },
    {
      "id": "smbhud-one-copy-diverges",
      "file": "tools/nes_studio_core/project.py",
      "find": "        if modules.get(\"game\", {}).get(\"config\", {}).get(\"type\") != \"smb\":",
      "replace": "        if modules.get(\"game\", {}).get(\"config\", {}).get(\"type\") != \"SMB\":",
      "expect": [
        "test_smbhud_bg_enabled_agrees_across_both_definitions"
      ]
    },
    {
      "id": "cell-tile-one-copy-diverges",
      "file": "tools/nes_studio_core/graphics.py",
      "find": "    return int(cell.get(\"tile\", 0)) & 0xFF",
      "replace": "    return int(cell.get(\"tile\", 0)) & 0x7F",
      "expect": [
        "test_cell_tile_agrees_across_both_definitions"
