    },
    {
      "id": "parity-coverage-blind-to-single-quotes",
      "file": "native/src/nes_studio/core/validators.py",
      "find": "#: The order the web runs them in",
      "replace": "def _probe_silent_drift(state: dict) -> Problem | None:\n    if state.get(\"__never__\"):\n        return Problem(id='probe-silent-drift', severity=\"warn\", message=\"p\", fix=\"p\")\n    return None\n\n\n#: The order the web runs them in",
      "expect": [
        "test_the_cases_exercise_every_check"
      ]
    },
    {
      "id": "a-mode-drops-out-of-the-registry",
      "file": "native/src/nes_studio/ui/modes/__init__.py",
      "find": "    CodeMode,\n",
      "replace": "",
      "expect": [
        "test_every_mode_on_disk_is_registered_in_mode_classes"
      ]
    },
    {
      "id": "a-shipped-starter-drops-out-of-the-picker",
      "file": "native/src/nes_studio/ui/project_catalog.py",
      "find": "    (\"scratch\", \"📄 Blank project\", \"Nothing at all. Build it from scratch.\"),\n",
      "replace": "",
      "expect": [
        "test_the_starter_picker_offers_exactly_what_is_shipped"
      ]
    }
  ]
}
