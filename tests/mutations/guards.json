    },
    {
      "id": "hex-table-loses-its-size-expression",
      "file": "tools/nes_studio_core/world.py",
      "find": "    output = [f\"const unsigned char {name}[{size_expression}] = {{\"]",
      "replace": "    output = [f\"const unsigned char {name}[{len(data)}] = {{\"]",
      "expect": [
        "test_hex_table_differs_deliberately_and_here_is_which_is_which"
